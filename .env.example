# Environment variables for the earnings pipeline.
# Copy this file to .env.local for local runs (never commit the copy),
# or set these as secrets in your deploy platform's dashboard/env group.

# --- Email delivery ---
EMAIL_PROVIDER=agentmail
AGENTMAIL_API_KEY=YOUR_AGENTMAIL_API_KEY
AGENTMAIL_INBOX_ID=YOUR_INBOX_ADDRESS
DEAL_ALERT_EMAIL_TO=YOUR_DAILY_EARNINGS_RECIPIENT
WEEKLY_BRIEFING_EMAIL_TO=YOUR_WEEKLY_EARNINGS_RECIPIENT
EARNINGS_EMAIL_FROM=YOUR_SEND_FROM_ADDRESS
EARNINGS_EMAIL_REPLY_TO=

# --- Cross-cron shared state (see README: "Why Convex") ---
# Render (and most serverless cron platforms) give each scheduled job its own
# fresh, ephemeral container -- two crons running 30 minutes apart do NOT
# share a filesystem. A hosted document store is what lets the digest cron
# read back what an earlier cron already synthesized instead of re-deriving
# it. Any similar store (Supabase, a hosted Postgres, DynamoDB) would work;
# this project used Convex.
CONVEX_URL=YOUR_CONVEX_DEPLOYMENT_URL
EARNINGS_ARCHIVE_TOKEN=YOUR_SHARED_ARCHIVE_WRITE_TOKEN

# --- Earnings calendar source ---
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY

# --- Live research providers ---
# Cascade order (see core/research.py): LLMLayer first, Tavily as a
# threshold-triggered backup, TinyFish as a last resort for full-page-content
# fetches (transcripts). Exa is supported but held back by default -- see
# _EXA_ENABLED in core/research.py. None of these are strictly required
# individually; the cascade degrades gracefully as providers are configured.
EXA_API_KEY=YOUR_EXA_API_KEY
LLMLAYER_API_KEY=YOUR_LLMLAYER_API_KEY
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
TINYFISH_API_KEY=YOUR_TINYFISH_API_KEY
TINYFISH_LANGUAGE=en
TINYFISH_LOCATION=US

# --- LLM synthesis ---
# Turns research snippets + financial facts into grounded, structured briefs.
# Required -- without it, synthesis falls back to a much plainer,
# non-narrative output.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_WEB_SEARCH_MODEL=gpt-4o-mini

# --- Coverage universe overrides (optional) ---
# Leave both unset to use the maintained default in
# pipelines/run_earnings_radar_automation.py (DEFAULT_COVERAGE_UNIVERSE /
# DEFAULT_FOCUS_SECTORS). Only set these if you want a deliberate, permanent
# override -- a stale value set once and forgotten here silently takes
# priority over future edits to the Python default.
EARNINGS_COVERAGE_UNIVERSE=
EARNINGS_FOCUS_SECTORS=
